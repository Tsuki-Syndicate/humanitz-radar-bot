# Bot Discord. Ne publie jamais ces valeurs.
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Serveur HumanitZ (RCON)
HUMANITZ_RCON_HOST=
HUMANITZ_RCON_PORT=
HUMANITZ_RCON_PASSWORD=

# Salons Discord. Laisse vide tant qu'ils ne sont pas crees.
HUMANITZ_STATUS_CHANNEL_ID=
# Salons supplementaires qui recoivent uniquement un miroir de l'etat du serveur, separes par des virgules.
HUMANITZ_STATUS_MIRROR_CHANNEL_IDS=
HUMANITZ_LOGS_CHANNEL_ID=
HUMANITZ_ANNOUNCEMENTS_CHANNEL_ID=
HUMANITZ_COMMANDS_CHANNEL_ID=
HUMANITZ_CONTROL_CHANNEL_ID=

# Informations publiques synchronisees dans les portails Discord.
HUMANITZ_PUBLIC_SERVER_ADDRESS=
HUMANITZ_PUBLIC_SERVER_PASSWORD=
HUMANITZ_CONNECTION_CHANNEL_IDS=
HUMANITZ_COMMUNITY_INVITE_URL=
HUMANITZ_COMMUNITY_LINK_CHANNEL_IDS=
HUMANITZ_ACTIVITY_ROLE_IDS=
HUMANITZ_ACTIVITY_ROLES_CHANNEL_ID=

# Roles qui pourront utiliser les futures commandes de gestion.
HUMANITZ_STAFF_ROLE_ID=
HUMANITZ_MEMBER_ROLE_ID=
HUMANITZ_ALERT_ROLE_ID=

# Frequence de mise a jour du statut (minimum 30 secondes).
HUMANITZ_STATUS_INTERVAL_SECONDS=60

# Redemarrage quotidien du serveur. Heure de Toronto par defaut.
HUMANITZ_DAILY_RESTART_ENABLED=1
HUMANITZ_DAILY_RESTART_HOUR=3
HUMANITZ_DAILY_RESTART_WARNING_MINUTES=15
HUMANITZ_DAILY_RESTART_TIMEZONE=America/Toronto

# Carte live HumanitZ. Ces limites correspondent a la carte 1.1 actuelle.
# Ne les change que si une future mise a jour du jeu deplace la carte.
HUMANITZ_MAP_X_MIN=3250
HUMANITZ_MAP_X_MAX=399150
HUMANITZ_MAP_Y_MIN=-398550
HUMANITZ_MAP_Y_MAX=-2650

# Panneau de gestion Web (local seulement par defaut).
# Le mode local n'accepte que les connexions depuis la machine qui lance le bot.
DASHBOARD_ENABLED=0
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8790
DASHBOARD_DEV_BYPASS=0

# Configuration necessaire uniquement pour publier le panneau avec connexion Discord OAuth.
DASHBOARD_PUBLIC_URL=
DASHBOARD_OAUTH_CLIENT_ID=
DASHBOARD_OAUTH_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
# Proprietaires supplementaires du panneau, separes par des virgules.
DASHBOARD_ADMIN_DISCORD_IDS=
